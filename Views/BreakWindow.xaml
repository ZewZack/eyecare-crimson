<Window x:Class="eyecarebyzewzack.Views.BreakWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EyeCare - Göz Dinlendirme Modu"
        Width="490" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="#07080C" 
            BorderBrush="#4D131C" 
            BorderThickness="1.2" 
            CornerRadius="20" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="4" Direction="270" Color="#991B1B" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtHeaderTitle" Text="🌿 Göz &amp; Beden Dinlendirme" 
                           FontWeight="Bold" FontSize="17" Foreground="#F3F4F6" 
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtHeaderSubtitle" Text="Ekrandan uzaklaşın, gözlerinizi ve kaslarınızı rahatlatın." 
                           FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0" 
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Center Countdown & Exercise -->
            <Grid Grid.Row="1" Margin="0,18,0,18">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Timer Circle -->
                    <Border Width="130" Height="130" CornerRadius="65" 
                            Background="#11131C" BorderBrush="#DC2626" BorderThickness="3">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Color="#DC2626" Opacity="0.4" ShadowDepth="0"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtBreakTime" Text="05:00" 
                                       FontWeight="Bold" FontSize="32" 
                                       Foreground="#F87171" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtBreakLabel" Text="Kalan Mola" FontSize="11" Foreground="#9CA3AF" 
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Eye Health Guide Card -->
                    <Border Background="#10121A" BorderBrush="#2A1116" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,16,0,0" Width="380">
                        <StackPanel>
                            <TextBlock x:Name="TxtExerciseTitle" Text="💡 20-20-20 Kuralı" 
                                       FontWeight="SemiBold" FontSize="12" Foreground="#FCA5A5"/>
                            <TextBlock x:Name="TxtExerciseDesc" 
                                       Text="Pencereden dışarı veya en az 6 metre uzağa 20 saniye bakın. Göz merceği kaslarınız bu mesafede gevşer." 
                                       FontSize="11" LineHeight="16" Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Actions -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Gözlerimi Dinlendirdim (Bitir)" Click="BtnFinishBreak_Click"
                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold"
                        FontSize="12" Padding="14,9" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="1" x:Name="BtnAddBreakTime" Content="+2 Dk Ekle" Click="BtnAdd2Min_Click"
                        Background="#13151F" Foreground="#E5E7EB" FontWeight="Medium"
                        FontSize="12" Padding="14,9" BorderThickness="1" BorderBrush="#35141A" 
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
