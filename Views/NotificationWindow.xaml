<Window x:Class="eyecarebyzewzack.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EyeCare Bildirim"
        Width="380" Height="210"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    
    <Border Background="#181A20" 
            BorderBrush="#313645" 
            BorderThickness="1" 
            CornerRadius="14" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="30" Height="30" CornerRadius="15" Background="#26EF4444" Margin="0,0,10,0">
                    <TextBlock Text="👁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EF4444"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Mola Vakti Geldi!" FontWeight="Bold" FontSize="14" Foreground="#F3F4F6"/>
                    <TextBlock x:Name="TxtSubtitle" Text="Maksimum oturma sınırına ulaşıldı" FontSize="11" Foreground="#9CA3AF"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="24" Height="24" Click="BtnClose_Click"
                        Background="Transparent" BorderThickness="0" Foreground="#6B7280"
                        Cursor="Hand" FontSize="13" VerticalAlignment="Top"/>
            </Grid>

            <!-- Message Body -->
            <TextBlock Grid.Row="1" x:Name="TxtMessage" TextWrapping="Wrap" Margin="0,12,0,12"
                       FontSize="12" LineHeight="18" Foreground="#D1D5DB"
                       Text="1 saattir aralıksız ekrana bakıyorsunuz. Göz kuruluğunu önlemek ve duruşunuzu düzeltmek için kalkıp dinlenmeniz önerilir."/>

            <!-- Action Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Start Break -->
                <Button Grid.Column="0" Content="☕ Mola Ver (5 dk)" Click="BtnBreak_Click"
                        Background="#10B981" Foreground="#FFFFFF" FontWeight="SemiBold"
                        FontSize="11" Padding="10,7" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- +5 Mins -->
                <Button Grid.Column="1" Content="+5 Dk" Click="BtnExt5_Click"
                        Background="#262A36" Foreground="#E5E7EB" FontWeight="Medium"
                        FontSize="11" Padding="10,7" BorderThickness="1" BorderBrush="#3B4254" 
                        Cursor="Hand" Margin="0,0,6,0" ToolTip="Meşgulüm, 5 dakika daha uzat">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- +10 Mins -->
                <Button Grid.Column="2" Content="+10 Dk" Click="BtnExt10_Click"
                        Background="#262A36" Foreground="#E5E7EB" FontWeight="Medium"
                        FontSize="11" Padding="10,7" BorderThickness="1" BorderBrush="#3B4254" 
                        Cursor="Hand" ToolTip="Aşırı meşgulüm, 10 dakika daha uzat">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
