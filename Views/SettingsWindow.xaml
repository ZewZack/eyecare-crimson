<Window x:Class="eyecarebyzewzack.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EyeCare Ayarlar"
        Width="440" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#14171F" 
            BorderBrush="#2B3142" 
            BorderThickness="1" 
            CornerRadius="16" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="⚙ Ayarlar" FontWeight="Bold" FontSize="16" Foreground="#F3F4F6"/>
                    <TextBlock Text="Kişiselleştirme ve çalışma tercihleri" FontSize="11" Foreground="#9CA3AF"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" Click="BtnClose_Click"
                        Background="Transparent" BorderThickness="0" Foreground="#9CA3AF"
                        Cursor="Hand" FontSize="13" VerticalAlignment="Top"/>
            </Grid>

            <!-- Settings Content List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    
                    <!-- Work Duration -->
                    <Border Background="#1C202C" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Maksimum Oturma Limiti" FontWeight="SemiBold" FontSize="12" Foreground="#E5E7EB"/>
                                <TextBlock Text="Kesintisiz oturulabilecek hedef süre" FontSize="10" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CmbWorkDuration" Width="90" Background="#262C3D" Foreground="#E5E7EB" BorderBrush="#3B4254">
                                <ComboBoxItem Content="30 dk" Tag="30"/>
                                <ComboBoxItem Content="45 dk" Tag="45"/>
                                <ComboBoxItem Content="60 dk (Önerilen)" Tag="60" IsSelected="True"/>
                                <ComboBoxItem Content="90 dk" Tag="90"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Break Duration -->
                    <Border Background="#1C202C" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mola Süresi" FontWeight="SemiBold" FontSize="12" Foreground="#E5E7EB"/>
                                <TextBlock Text="Her oturum sonrası dinlenme vakti" FontSize="10" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CmbBreakDuration" Width="90" Background="#262C3D" Foreground="#E5E7EB" BorderBrush="#3B4254">
                                <ComboBoxItem Content="3 dk" Tag="3"/>
                                <ComboBoxItem Content="5 dk (Önerilen)" Tag="5" IsSelected="True"/>
                                <ComboBoxItem Content="10 dk" Tag="10"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Idle Detection -->
                    <Border Background="#1C202C" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Akıllı Boşta Kalma (Idle) Algılama" FontWeight="SemiBold" FontSize="12" Foreground="#E5E7EB"/>
                                    <TextBlock Text="Masadan kalktığınızda süreyi otomatik durdurur" FontSize="10" Foreground="#9CA3AF"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ChkIdleDetect" IsChecked="True" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Boşta Sayılma Eşiği" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="CmbIdleThreshold" Width="90" Background="#262C3D" Foreground="#E5E7EB" BorderBrush="#3B4254">
                                    <ComboBoxItem Content="2 dk" Tag="2"/>
                                    <ComboBoxItem Content="3 dk" Tag="3" IsSelected="True"/>
                                    <ComboBoxItem Content="5 dk" Tag="5"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Sound Notification -->
                    <Border Background="#1C202C" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sesli Bildirim" FontWeight="SemiBold" FontSize="12" Foreground="#E5E7EB"/>
                                <TextBlock Text="Süre dolduğunda hafif uyarı tonu çalar" FontSize="10" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ChkSound" IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Windows Startup -->
                    <Border Background="#1C202C" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Windows ile Başlat" FontWeight="SemiBold" FontSize="12" Foreground="#E5E7EB"/>
                                <TextBlock Text="Bilgisayar açıldığında arka planda başlar" FontSize="10" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ChkStartup" IsChecked="False" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Minimize on close -->
                    <Border Background="#1C202C" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kapatınca Tepsiye Küçült" FontWeight="SemiBold" FontSize="12" Foreground="#E5E7EB"/>
                                <TextBlock Text="Çarpıya basınca arka planda izlemeye devam eder" FontSize="10" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ChkMinToTray" IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Save Button -->
            <Button Grid.Row="2" Content="Ayarları Kaydet" Click="BtnSave_Click"
                    Background="#10B981" Foreground="#FFFFFF" FontWeight="SemiBold"
                    FontSize="12" Padding="0,10" BorderThickness="0" Cursor="Hand" Margin="0,14,0,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
